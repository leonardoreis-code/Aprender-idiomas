{
  "name": "aprender-idiomas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "audio": "node scripts/generate-audio.mjs",
    "e2e": "vite build && (PORT=8787 node server/index.mjs & sleep 1.5; NODE_PATH=$(npm root -g) node scripts/e2e/smoke.mjs; s=$?; kill %1; exit $s)",
    "gauntlet": "npm run typecheck && npm test && npm run build",
    "start": "node server/index.mjs",
    "dev:api": "node server/index.mjs"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.36.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-fsrs": "^6.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^31.0.1",
    "typescript": "5.8",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
